# Copy to .env (git-ignored) and fill in. Never commit .env.

# REQUIRED. Group enrollment secret, >= 16 chars. Generate with:
#   openssl rand -hex 24
ECB_ENROLL_TOKEN=replace-with-output-of-openssl-rand-hex-24

# REQUIRED for production (profile "tunnel"). Cloudflare Zero Trust dashboard ->
# Networks -> Tunnels -> create a tunnel (Docker) -> copy the token from the
# shown command. Set the public hostname's Service URL to http://relay:8080
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional (defaults shown).
# ECB_MAX_ITEM_BYTES=33554432
# ECB_ITEM_TTL=10m
# true = rate limits use CF-Connecting-IP (correct behind Cloudflare Tunnel)
# ECB_TRUST_PROXY_HEADERS=true
